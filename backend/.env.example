# 轻步 LightStep 后端配置（复制为 .env 后按需修改）
#
# LLM 提供方：
#   mock   —— 离线模式（默认），无需任何 key，用预设拆解 + 规则情绪判断，跑通全流程
#   openai —— 走 OpenAI 兼容 API（DeepSeek / 豆包 / OpenAI 等都可，改 BASE_URL 即可）
LLM_PROVIDER=mock

# 以下仅 LLM_PROVIDER=openai 时生效
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30

# 数据文件（相对项目根目录）
LIGHTSTEP_DB=lightstep.db

# 自适应步骤粒度阈值（秒）
# 单步耗时 < 15s 判定"状态在线"→ 加量；> 90s 判定"启动吃力"→ 拆细
FAST_THRESHOLD=15
SLOW_THRESHOLD=90

# HTTP 服务：本机默认仅回环监听；联调时按实际网络设置主机和端口
LIGHTSTEP_HOST=127.0.0.1
LIGHTSTEP_PORT=8000
LIGHTSTEP_RELOAD=true
# 独立部署 API 时设 false，关闭附带网页调试页
LIGHTSTEP_SERVE_DEBUG_UI=true
# 浏览器前端允许的来源，逗号分隔；上线时填写自己的实际来源
LIGHTSTEP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
