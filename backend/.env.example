# 轻步 LightStep 后端配置（复制为 .env 后按需修改）
#
# LLM 提供方：
#   openai —— 走 OpenAI 兼容 API（DeepSeek / 豆包 / OpenAI 等都可，改 BASE_URL 即可）
LLM_PROVIDER=openai

# 以下仅 LLM_PROVIDER=openai 时生效
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30
# 控制单次输出量；默认示例使用 DeepSeek 非思考模式以降低交互延迟
LLM_MAX_TOKENS=1024
# 森林一次生成三层完整关系，使用独立输出预算，不增加普通聊天预算
LLM_DECOMPOSE_MAX_TOKENS=4096
LLM_THINKING=disabled
# 换用不支持 thinking 扩展参数的供应商时，将 LLM_THINKING 留空

# 数据文件（相对项目根目录）
LIGHTSTEP_DB=lightstep.db

# 耗时反馈阈值（秒）；旧队列可自动调档，新森林只记录反馈不自动改档
# 单步耗时 < 15s 判定"状态在线"→ 加量；> 90s 判定"启动吃力"→ 拆细
FAST_THRESHOLD=15
SLOW_THRESHOLD=90

# HTTP 服务：本机默认仅回环监听；联调时按实际网络设置主机和端口
LIGHTSTEP_HOST=127.0.0.1
LIGHTSTEP_PORT=8000
LIGHTSTEP_RELOAD=true
# 独立部署 API 时设 false，关闭附带网页调试页
LIGHTSTEP_SERVE_DEBUG_UI=true
# 浏览器前端允许的来源，逗号分隔；上线时填写自己的实际来源
LIGHTSTEP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
